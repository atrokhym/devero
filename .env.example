# Devero Automation Configuration

# Base URL for your Devero instance
DEVERO_URL=https://example.devero.com

# Login Credentials
DEVERO_USERNAME=your_username_here
DEVERO_PASSWORD=your_password_here

# Browser & Automation Settings
# Set DEVERO_HEADLESS=true to run browser in background (headless)
DEVERO_HEADLESS=false

# CDP Connection URL (optional - leave blank unless connecting to existing debug Chrome)
DEVERO_CDP_URL=http://127.0.0.1:9222

# Optional visit-note v2 API reasoning effort: none, low, medium, high, xhigh, or max
# OPENAI_REASONING_EFFORT=high
